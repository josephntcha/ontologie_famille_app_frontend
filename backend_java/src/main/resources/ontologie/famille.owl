        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Masculin"/>
