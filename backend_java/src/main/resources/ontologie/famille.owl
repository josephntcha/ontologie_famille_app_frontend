        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#descendantDe"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#ancetreDe"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#marieA -->

