    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#grandParentDe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#grandParentDe">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#GrandParent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#PetitEnfant"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#parentDe"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#parentDe"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#lienDeSangAvec -->

