                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#beauParentDe"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
                    </owl:Restriction>
                </owl:intersectionOf>
