        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#BeauPere -->

    <owl:Class rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#BeauPere">
