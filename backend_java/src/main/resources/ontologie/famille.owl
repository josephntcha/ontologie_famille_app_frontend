    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#aPourConjoint -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#aPourConjoint">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Mariage"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#ancetreDe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#ancetreDe">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#lienDeSangAvec"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#beauParentDe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#beauParentDe">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#marieA"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Parent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#parentDe"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#conjointDans -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#conjointDans">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#aPourConjoint"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#descendantDe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#descendantDe">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#ancetreDe"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#enfantDe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#enfantDe">
