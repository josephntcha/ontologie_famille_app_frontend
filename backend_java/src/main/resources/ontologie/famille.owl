    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#BeauFils -->

    <owl:Class rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#BeauFils">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Masculin"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#marieA"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Fille"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#Personne"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sunday/ontologies/2026/9/untitled-ontology-2#BeauParent -->

